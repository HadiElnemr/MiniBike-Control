% clear workspace, close open figures
clear all
close all
clc 

load('result0');

f1 = figure(1);
plot(x(1,:),x(2,:),'k'), grid on, hold on,
xlabel('state $x(1)$','FontSize',10,'Interpreter','latex');
ylabel('state $x(2)$','FontSize',10,'Interpreter','latex');
drawnow
   
f2 = figure(2);
plot(u,'k'), grid on, hold on,
xlabel('MPC iteration','FontSize',10,'Interpreter','latex');
ylabel('input $u$','FontSize',10,'Interpreter','latex');
drawnow

load('result2');

f1 = figure(1);
plot(x(1,:),x(2,:),'b-.'), grid on, hold on,
legend('closed-loop state when $Q=I, R=1$','closed-loop state when $Q=I, R=0.01$','location','southeast');
set(legend,'Interpreter','latex');
set(legend,'FontSize',12);
set(gca,'FontSize',12);
f1.Position = [10 50 550 400]; 
drawnow
   

u_max = 10*ones(1, 300);

f2 = figure(2);
plot(u,'b-.'), grid on, hold on,
plot(u_max,'r'), grid on, hold on,
legend('closed-loop input when $Q=I, R=1$','closed-loop input when $Q=I, R=0.01$','input constraint');
set(legend,'Interpreter','latex');
set(legend,'FontSize',12);
set(gca,'FontSize',12);
ylim([-2 12]);
f2.Position = [560 30 550 400]; 
drawnow
